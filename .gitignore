DailyBriefing/.gitignore
# Gradle files
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc.)
local.properties

# IDE files
.idea/
*.iml
*.ipr
*.iws
out/

# Generated files
captures/
.externalNativeBuild/
.cxx/

# Log files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Keystore files (don’t ever commit your signing keys)
*.jks
*.keystore

# Google Services (avoid committing API keys/secrets)
google-services.json
app/google-services.json

# OS-specific
.DS_Store
Thumbs.db

# Kotlin/Java specific
*.class
*.jar
*.war
*.ear

# Others
*.apk
*.ap_
*.aab
*.so
*.dex

# Backup files
*.bak
*.swp
*.tmp
*.orig
*.rej

# VSCode (if used alongside Android Studio)
.vscode/
